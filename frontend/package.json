{
  "name": "label-printer-ui",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:main",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "build:main": "vue-tsc --noEmit -p tsconfig.main.json && vite build",
    "build:companion": "vue-tsc --noEmit -p tsconfig.companion.json && vite build --mode companion",
    "build:all": "npm run build:main && npm run build:companion"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@heroicons/vue": "^2.2.0",
    "@lezer/highlight": "^1.2.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
