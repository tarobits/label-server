LABEL_DATABASE_URL=sqlite:///./data/labels.db
LABEL_WORKER_INTERVAL_SECONDS=2
# Configure printers in the web UI under Printers & groups.
# For docker-compose.usb.yml, set the current /dev/bus/usb/BBB/DDD and device group ID.
# LABEL_USB_DEVICE=/dev/bus/usb/BBB/DDD
# LABEL_USB_GID=DEVICE_GROUP_ID
# Configure ntfy and email notification endpoints in Administration.
LABEL_PUBLIC_URL=http://localhost:8000
# Only enable when the origin is reachable exclusively through Cloudflare.
# See docs/DEPLOYMENT.md#session-details for visitor IP and approximate location.
LABEL_TRUST_CLOUDFLARE_HEADERS=false
# Web Push: generate a persistent key with `python -m app.push_delivery --generate-key data/vapid-private.pem`.
# Keep the key private and backed up. See docs/DEPLOYMENT.md#push-notifications.
# LABEL_VAPID_PRIVATE_KEY_FILE=data/vapid-private.pem
# LABEL_VAPID_SUBJECT=mailto:admin@example.com
# Shared SMTP service for recovery links and email notifications.
# Set LABEL_PUBLIC_URL to the externally reachable HTTPS address in production.
# For Docker Compose SMTP forwarding, see docs/DEPLOYMENT.md#email-configuration.
# LABEL_SMTP_HOST=smtp.example.com
# LABEL_SMTP_PORT=587
# Security: starttls (default, port 587), ssl (implicit TLS, port 465),
# or plain (unencrypted; only for a trusted local relay).
# LABEL_SMTP_SECURITY=starttls
# LABEL_SMTP_USERNAME=label-server
# LABEL_SMTP_PASSWORD=
# LABEL_SMTP_FROM=labels@example.com
# LABEL_SMTP_FROM_NAME="Taro's Label Room"
# Optional override; defaults to frontend/dist next to the source tree.
# LABEL_FRONTEND_DIST=/path/to/frontend/dist
# Release checks and updater access when using a private GitHub repository.
# Use a fine-grained token restricted to this repository, Contents: read-only.
# Keep .env readable only by the installation owner (chmod 600 .env).
# LABEL_GITHUB_TOKEN=github_pat_...
# Native alternative: keep the raw token in a separate service-readable file.
# LABEL_GITHUB_TOKEN_FILE=/etc/label-server/github-token
LABEL_CHECK_FOR_UPDATES=true
