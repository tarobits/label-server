LABEL_DATABASE_URL=sqlite:///./data/labels.db
LABEL_WORKER_INTERVAL_SECONDS=2
# Configure printers in the web UI under Printers & groups.
# For docker-compose.usb.yml, set the current /dev/bus/usb/BBB/DDD and device group ID.
# LABEL_USB_DEVICE=/dev/bus/usb/001/005
# LABEL_USB_GID=10001
# Configure ntfy notification endpoints in Administration.
LABEL_PUBLIC_URL=http://localhost:8000
# Optional override; defaults to frontend/dist next to the source tree.
# LABEL_FRONTEND_DIST=/path/to/frontend/dist
