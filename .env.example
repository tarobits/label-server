LABEL_DATABASE_URL=sqlite:///./data/labels.db
LABEL_WORKER_INTERVAL_SECONDS=2
LABEL_MOCK_TAPE_WIDTH_MM=24
# Leave mock enabled until ready to print on the physical device.
LABEL_PRINTER_BACKEND=mock
# Use brother-pt-p710bt for USB printing. Serial is required if multiple matching devices exist.
LABEL_PRINTER_USB_SERIAL=
LABEL_PRINTER_TIMEOUT_SECONDS=120
LABEL_PRINTER_FEED_MM=2
LABEL_PRINTER_LEADER_MM=24.5
LABEL_PRINTER_CUT_EACH=true
# normal = 180 x 180 dpi; high = 180 across tape x 360 along tape (new jobs/drafts).
LABEL_PRINTER_RESOLUTION=normal
# For docker-compose.usb.yml, set the current /dev/bus/usb/BBB/DDD and device group ID.
# LABEL_USB_DEVICE=/dev/bus/usb/001/005
# LABEL_USB_GID=10001
LABEL_NTFY_URL=
LABEL_NTFY_TOPIC=
LABEL_NTFY_TOKEN=
LABEL_PUBLIC_URL=http://localhost:8000
# Optional override; defaults to frontend/dist next to the source tree.
# LABEL_FRONTEND_DIST=/path/to/frontend/dist
