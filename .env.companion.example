LABEL_COMPANION_SERVER_URL=https://labels.example.com
LABEL_COMPANION_API_KEY=
# Separate read-only key for external displays; blank disables /api/status.
# Use a randomly generated token with at least 32 characters. Never reuse the main-server key.
LABEL_COMPANION_STATUS_API_KEY=
LABEL_COMPANION_DATA_DIR=data/companion
LABEL_COMPANION_PUBLIC_URL=http://localhost:8001
# JSON list of exact parent origins allowed to embed this companion. Empty = same-origin only.
# For cross-site session cookies the companion must use HTTPS; browser cookie policies still apply.
LABEL_COMPANION_FRAME_ANCESTORS=[]
LABEL_COMPANION_HOST=127.0.0.1
LABEL_COMPANION_PORT=8001
# DEBUG includes successful HTTP requests; INFO keeps redirects, warnings and errors.
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LABEL_COMPANION_LOG_LEVEL=INFO
# Show newer stable releases reported by the main server's update checker.
LABEL_COMPANION_SHOW_UPDATE_NOTICE=true
LABEL_COMPANION_LOCK_TIMEOUT_SECONDS=300
# Show operational counts, cartridge levels and batch status before unlocking.
LABEL_COMPANION_SHOW_LOCKED_DASHBOARD_DETAILS=true
LABEL_COMPANION_PIN_KEYPAD_ENABLED=false
# Number layout: none, once (per entry attempt), or each_keypress.
LABEL_COMPANION_PIN_KEYPAD_SHUFFLE=none

# Add and configure printers through the companion web interface.
# Optional initial bootstrap; later changes are saved through the web interface.
# LABEL_COMPANION_PRINTERS='[{"local_id":"desk","name":"Desk printer","driver":"brother-pt-p710bt","configuration":{}}]'

# User-picker mode: leave both settings unset. Users set PINs in Account settings.
# Single-user mode: set both, after an administrator binds the user on the server.
# LABEL_COMPANION_SINGLE_USER_ID=
# LABEL_COMPANION_SHARED_PIN=

LABEL_COMPANION_ALLOW_LOCKED_EMERGENCY_STOP=false
LABEL_COMPANION_ALLOW_LOCKED_STOP_AFTER_LABEL=false
LABEL_COMPANION_ALLOW_OFFLINE_EMERGENCY_STOP=false
LABEL_COMPANION_ALLOW_OFFLINE_STOP_AFTER_LABEL=false
